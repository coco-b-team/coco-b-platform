# App
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini
# Create from Google AI Studio / Google Cloud
GEMINI_API_KEY=

# Optional: Vercel KV (Storage → KV desde el dashboard de Vercel), para que
# el límite de mensajes del chat sea compartido de verdad entre todas las
# instancias del servidor. Sin esto, el chat sigue funcionando igual, pero
# el límite de mensajes se guarda solo en memoria (ver lib/ai/rateLimit.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# WordPress Backend
WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json
WORDPRESS_SITE_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# HubSpot — token de una private app (Settings > Integrations > Private
# Apps), con scope de escritura sobre contactos (crm.objects.contacts.write).
# Los envíos se hacen vía la API de CRM (upsert de contacto por email), no
# vía el endpoint público de formularios.
HUBSPOT_ACCESS_TOKEN=

# Correos transaccionales (Resend). El remitente debe pertenecer a un dominio
# verificado en Resend. Si RESEND_API_KEY está vacío, no se envían confirmaciones.
RESEND_API_KEY=
EMAIL_FROM=Coco B Isla <reservations@cocobisla.com>
EMAIL_REPLY_TO=reservations@cocobisla.com

# Figma — Personal Access Token para extraer tokens/contenido de diseño
# vía la API de Figma (Settings → Personal access tokens en Figma)
FIGMA_API_TOKEN=

# Database, if this platform will have its own DB later
DATABASE_URL=

# Auth / Sessions, if needed later
AUTH_SECRET=

# Anti-spam (Cloudflare Turnstile) — la Site Key es pública, va con NEXT_PUBLIC_
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
